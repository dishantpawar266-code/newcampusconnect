# Campus Connect 3.0 — Environment Configuration
# Copy this file to .env and fill in your real values.
# Set these same environment variables in your Vercel Project Settings > Environment Variables.

# Secret key for secure session cookies (generate a random 32+ character string)
FLASK_SECRET_KEY=generate_a_random_secure_32_character_string_here

# Secure Server-side Admin Credentials (never exposed to client)
ADMIN_EMAIL=admin@campusconnect.edu
ADMIN_PASSWORD=AdminSecurePass@2026

# Permanent Cloud Database Configuration for Vercel
# SQLite on Vercel is ephemeral (data lost on cold start). A cloud PostgreSQL is REQUIRED.
# Recommended FREE providers:
#   1. Neon Postgres (https://neon.tech) — 1-click free serverless Postgres
#   2. Supabase (https://supabase.com) — Free hosted Postgres
#   3. Vercel Postgres (via Vercel Dashboard Storage tab)
#
# Format: postgresql://username:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Flask environment
FLASK_ENV=production
