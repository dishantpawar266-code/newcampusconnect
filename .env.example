# Campus Connect 3.0 — Environment Configuration
# Copy this file to .env and fill in your real values

FLASK_SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
ADMIN_SECRET_CODE=change-this-to-your-secret-admin-code

# Database Configuration for Vercel
# If empty, it will default to local SQLite (sqlite:///campus_connect.db)
# For production (Vercel), use a PostgreSQL URL like from Supabase, Neon, or Vercel Postgres:
# DATABASE_URL=postgresql://user:password@host/dbname

# Flask environment
FLASK_ENV=development
